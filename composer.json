{
    "name": "mudren/api.mud.ren",
    "description": "A Laravel application.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "beyondcode/laravel-self-diagnosis": "^3.1",
        "erusev/parsedown": "~1.7.4",
        "erusev/parsedown-extra": "^0.8.1",
        "guzzlehttp/guzzle": "^7.9",
        "joypixels/emoji-toolkit": "^11.0",
        "laravel/framework": "^13.0",
        "laravel/helpers": "^1.8",
        "laravel/passport": "^13.8",
        "laravel/tinker": "^3.0",
        "laravolt/avatar": "^7.0",
        "mews/purifier": "^3.4.4",
        "overtrue/easy-sms": "^2.7",
        "overtrue/laravel-follow": "^1.1.16",
        "overtrue/laravel-uploader": "^3.4",
        "predis/predis": "^3.0",
        "sentry/sentry-laravel": "^4.27",
        "spatie/laravel-activitylog": "^4.12",
        "tucker-eric/eloquentfilter": "^3.6",
        "vinkla/hashids": "^14.0"
    },
    "require-dev": {
        "ext-json": "*",
        "fakerphp/faker": "^1.19",
        "filp/whoops": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.0",
        "mockery/mockery": "^1.0",
        "nunomaduro/collision": "^8.9",
        "overtrue/laravel-query-logger": "^5.1",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "classmap": ["database/seeds"],
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "scripts": {
        "phpcs": "vendor/bin/php-cs-fixer fix",
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "8.3.0"
        },
        "optimize-autoloader": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
